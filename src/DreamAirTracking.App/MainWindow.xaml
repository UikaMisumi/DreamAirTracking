<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DreamAirTracking.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DreamAirTracking.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DreamAirTracking"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="DreamAirTracking"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Dashboard"
                    IsSelected="True"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Calibration" Tag="calibration">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Diagnostics" Tag="pipeline">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA3A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavFrame" />
        </NavigationView>

        <Grid
            x:Name="CalibrationOverlayHost"
            Grid.RowSpan="2"
            Padding="28"
            Background="#FA0E1118"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                HorizontalAlignment="Right"
                Content="Cancel"
                Click="CalibrationOverlayCancel_Click" />

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18">
                <TextBlock
                    x:Name="CalibrationOverlayStageText"
                    HorizontalAlignment="Center"
                    FontSize="56"
                    FontWeight="SemiBold"
                    Text="center" />
                <TextBlock
                    x:Name="CalibrationOverlayInstructionText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Look at this point." />
                <TextBlock
                    x:Name="CalibrationOverlayCountdownText"
                    HorizontalAlignment="Center"
                    FontSize="132"
                    FontWeight="Bold"
                    Text="3" />
                <ProgressBar
                    x:Name="CalibrationOverlayProgressBar"
                    Width="420"
                    Height="8"
                    Maximum="1"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="CalibrationOverlayStatusText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Ready" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
