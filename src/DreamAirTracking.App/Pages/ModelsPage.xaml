<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DreamAirTracking.App.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DreamAirTracking.App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Models" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Browse Hugging Face model versions, download one, then select installed models on Home." />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            IsOpen="True"
            Severity="Informational"
            Title="Hugging Face source"
            Message="Remote list: Sumirui/dreamairtracking-dreamair-main-current. Downloads are installed locally and never replace running eye tracking." />

        <CommandBar
            Grid.Row="2"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True">
            <AppBarButton x:Name="RefreshRemoteButton" Icon="Refresh" Label="Refresh remote list" Click="RefreshRemote_Click" />
            <AppBarButton x:Name="CancelDownloadButton" Icon="Cancel" Label="Cancel download" Click="CancelDownload_Click" Visibility="Collapsed" />
            <AppBarButton Icon="Folder" Label="Open model folder" Click="OpenModelFolder_Click" />
            <AppBarButton Icon="Home" Label="Open Home" Click="OpenHome_Click" />
        </CommandBar>

        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="16">
                <InfoBar
                    x:Name="StatusInfoBar"
                    IsOpen="False"
                    Severity="Informational"
                    Title="Models">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="StatusMessageText"
                            Text="Ready"
                            TextWrapping="Wrap" />
                        <ProgressBar
                            x:Name="DownloadProgressBar"
                            Height="6"
                            IsIndeterminate="True"
                            Maximum="1"
                            Minimum="0"
                            Visibility="Collapsed" />
                    </StackPanel>
                </InfoBar>

                <Border Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Remote models" />
                        <TextBlock
                            x:Name="RemoteSummaryText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Refresh remote list to load available Hugging Face model versions."
                            TextWrapping="Wrap" />
                        <ListView x:Name="RemotePackagesList" SelectionMode="None" />
                    </StackPanel>
                </Border>

                <Border Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Installed models" />
                        <TextBlock
                            x:Name="InstalledSummaryText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Installed model packages appear here and in Home."
                            TextWrapping="Wrap" />
                        <ListView x:Name="InstalledPackagesList" SelectionMode="None" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
