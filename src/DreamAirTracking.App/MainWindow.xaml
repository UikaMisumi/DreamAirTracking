<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DreamAirTracking.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DreamAirTracking.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DreamAirTracking"
    mc:Ignorable="d">
    <Grid Background="#20242D">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Background="#171B24"
            BorderBrush="#303746"
            BorderThickness="0,0,1,0">
            <Grid Padding="12,18" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0,0,18">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="DreamAirTracking" />
                </StackPanel>

                <Button Grid.Row="1" HorizontalAlignment="Stretch" Content="Dashboard" Tag="home" Click="NavButton_Click" />
                <Button Grid.Row="2" HorizontalAlignment="Stretch" Content="Calibration" Tag="calibration" Click="NavButton_Click" />
                <Button Grid.Row="3" HorizontalAlignment="Stretch" Content="Diagnostics" Tag="pipeline" Click="NavButton_Click" />
                <Button Grid.Row="4" HorizontalAlignment="Stretch" Content="About" Tag="about" Click="NavButton_Click" />
                <Button Grid.Row="6" HorizontalAlignment="Stretch" Content="Settings" Tag="settings" Click="NavButton_Click" />
            </Grid>
        </Border>

        <Frame x:Name="NavFrame" Grid.Column="1" />

        <Grid
            x:Name="CalibrationOverlayHost"
            Grid.ColumnSpan="2"
            Padding="28"
            Background="#FA0E1118"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                HorizontalAlignment="Right"
                Content="Cancel"
                Click="CalibrationOverlayCancel_Click" />

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18">
                <TextBlock
                    x:Name="CalibrationOverlayStageText"
                    HorizontalAlignment="Center"
                    FontSize="56"
                    FontWeight="SemiBold"
                    Text="center" />
                <TextBlock
                    x:Name="CalibrationOverlayInstructionText"
                    HorizontalAlignment="Center"
                    Foreground="#C9D1DE"
                    Text="Look at this point." />
                <TextBlock
                    x:Name="CalibrationOverlayCountdownText"
                    HorizontalAlignment="Center"
                    FontSize="132"
                    FontWeight="Bold"
                    Text="3" />
                <ProgressBar
                    x:Name="CalibrationOverlayProgressBar"
                    Width="420"
                    Height="8"
                    Maximum="1"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="CalibrationOverlayStatusText"
                    HorizontalAlignment="Center"
                    Foreground="#C9D1DE"
                    Text="Ready" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
