<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DreamAirTracking.App.Pages.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Sessions" />
                <TextBlock x:Name="RootText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Scanning calibration records" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh" Click="Refresh_Click" />
                <Button x:Name="StartWatcherButton" Content="Start watcher" Click="StartWatcher_Click" />
                <Button x:Name="StopWatcherButton" Content="Stop watcher" Click="StopWatcher_Click" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="SummaryInfoBar"
            Grid.Row="1"
            IsOpen="True"
            Severity="Informational"
            Title="Audit"
            Message="Loading session audit." />

        <InfoBar
            x:Name="WatcherInfoBar"
            Grid.Row="2"
            IsOpen="True"
            Severity="Informational"
            Title="Watcher"
            Message="Loading automatic pipeline status." />

        <ListView
            x:Name="SessionsList"
            Grid.Row="3"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14" Margin="0,0,0,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding SessionId}" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Quality}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding CategoryLabel}" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding AverageResidualText}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Decision}" TextWrapping="Wrap" />

                            <Button
                                Grid.Column="3"
                                Content="Export package"
                                Tag="{Binding Directory}"
                                Click="ExportTrainingPackage_Click" />

                            <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Directory}" TextWrapping="Wrap" />

                            <Grid Grid.Row="2" Grid.ColumnSpan="4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding MissingStageDisplay}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding PoorLabelDisplay}" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="{Binding HighResidualDisplay}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ImageTrainingDisplay}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
