<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DreamAirTracking.App.Pages.PipelineDiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Pipeline Diagnostics" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="BrokenEye, Bridge, VRCFT, VRChat FT/v2, and avatar gates." />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Live Chain" />
                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="BrokenEye live" />
                            <TextBlock x:Name="BrokenEyeStatusText" Grid.Column="1" Text="checking" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Bridge pupil" />
                            <TextBlock x:Name="BridgePupilStatusText" Grid.Row="1" Grid.Column="1" Text="checking" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="VRCFT loaded" />
                            <TextBlock x:Name="VrcftStatusText" Grid.Row="2" Grid.Column="1" Text="checking" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Wear template" />
                            <TextBlock x:Name="WearTemplateStatusText" Grid.Row="3" Grid.Column="1" Text="checking" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="VRChat Avatar" />
                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="OscQuery" />
                            <TextBlock x:Name="OscQueryStatusText" Grid.Column="1" Text="checking" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="FT/v2 pupil" />
                            <TextBlock x:Name="VrchatPupilStatusText" Grid.Row="1" Grid.Column="1" Text="checking" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Pupil gate aliases" />
                            <TextBlock x:Name="AvatarGateStatusText" Grid.Row="2" Grid.Column="1" Text="checking" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Bridge Monitor" />
                        <TextBlock x:Name="BridgeMonitorText" Text="Waiting for UDP 9401" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LeftEyeText" Text="Left: --" TextWrapping="Wrap" />
                            <TextBlock x:Name="RightEyeText" Grid.Column="1" Text="Right: --" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
